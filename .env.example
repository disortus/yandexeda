# --- Application profile ---
SPRING_PROFILES_ACTIVE=dev
APP_NAME=demo
SERVER_PORT=8080

# --- Logging ---
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG

# --- JWT ---
JWT_ISSUER=demo-api
# In prod use a unique random secret and keep it outside git.
JWT_SECRET=please-change-this-secret-to-at-least-32-bytes
JWT_ACCESS_TOKEN_MINUTES=60

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Request-Id
CORS_EXPOSED_HEADERS=X-Request-Id

# --- Dev DB (PostgreSQL) ---
DEV_DB_URL=jdbc:postgresql://localhost:5432/demo_dev
DEV_DB_USER=postgres
DEV_DB_PASS=postgres
DEV_DB_POOL_MAX_SIZE=10
DEV_DB_POOL_MIN_IDLE=2
DEV_SHOW_SQL=true

# --- Prod DB (PostgreSQL cloud) ---
# These values are required when SPRING_PROFILES_ACTIVE=prod.
PROD_DB_URL=jdbc:postgresql://your-cloud-host:5432/demo_prod
PROD_DB_USER=cloud_user
PROD_DB_PASS=cloud_password
PROD_DB_POOL_MAX_SIZE=20
PROD_DB_POOL_MIN_IDLE=4

# --- Test DB (SQLite) ---
TEST_DB_URL=jdbc:sqlite:file:demo-test?mode=memory&cache=shared
TEST_DB_USER=admin
TEST_DB_PASS=admin
